# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL local (Docker)
DATABASE_URL="postgresql://agrotech:agrotech123@localhost:5432/agro_tech_db?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-seguro-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Google Sign-In — exclusivo del login "Otro rol" (el modo Campesino usa solo
# celular, sin Google). Sin autoregistro: el email debe existir ya como User
# no-Campesino, ver signIn() en src/lib/auth.ts. Callback URL a registrar en
# Google Cloud Console: {NEXTAUTH_URL}/api/auth/callback/google (una entrada
# para localhost y otra para el dominio de producción).
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret"

# ── IA (AgroIA) ───────────────────────────────────────────────────────────────
# Proveedor real en producción: Groq (openai/gpt-oss-20b — llama-3.1-8b-instant
# fue retirado por Groq el 16 de agosto de 2026). Requerida para que el
# Asistente IA (/dashboard/asistente) y el motor de contexto funcionen.
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ANTHROPIC_API_KEY queda documentada por si se reintroduce Claude como proveedor
# (ver CLAUDE.md §3 y ADR-006 en docs/REQUERIMIENTOS.md), pero HOY no la usa el código.
# ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Weather APIs ──────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY="tu-api-key-de-openweathermap"
# IDEAM datos abiertos (no requiere key para endpoints públicos)

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AgroTech"
NODE_ENV="development"

# ── Rate limiting (Upstash Redis) ───────────────────────────────────────────────
# Protege login (fuerza bruta) y endpoints de IA (ráfagas de costo dentro del
# mismo día, antes de que la cuota diaria de UsoIaDiario llegue a frenarlas).
# Cuenta gratis en https://upstash.com (free tier: 10.000 comandos/día) — crear
# una base Redis y copiar el "REST URL"/"REST TOKEN" de su panel, no las
# credenciales de conexión TCP. Sin estas variables, src/lib/rate-limit.ts no
# bloquea nada (deja pasar todo) y solo avisa una vez por consola — así el
# entorno local sigue funcionando aunque no se haya creado la cuenta todavía.
UPSTASH_REDIS_REST_URL="https://tu-base.upstash.io"
UPSTASH_REDIS_REST_TOKEN="tu-token-de-upstash"

# ── Email transaccional (Resend) ────────────────────────────────────────────────
# Verificación de correo al registrarse y recuperación de contraseña (Fase 1
# SaaS, Tanda 2) — ver src/lib/email.ts. Cuenta gratis en https://resend.com.
# Dominio propio `creciagro.com` ya verificado en Resend (2026-09-17) —
# entrega a cualquier destinatario real, no solo al dueño de la cuenta de
# Resend. Sin esta variable, src/lib/email.ts no envía nada — solo loguea el
# enlace a consola, así el flujo se puede probar en dev sin cuenta.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Cron (calendario proactivo de actividades) ─────────────────────────────────
# Protege GET /api/cron/generar-alertas (Vercel Cron, ver vercel.json) — Vercel
# envía este mismo valor como "Authorization: Bearer $CRON_SECRET" en cada
# invocación programada. Generar con `openssl rand -base64 32` o similar; no
# es necesario en local salvo que quieras probar la ruta manualmente con curl.
CRON_SECRET="genera-un-secreto-aleatorio-largo"
