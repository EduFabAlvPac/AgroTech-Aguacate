generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  password     String?
  role         UserRole @default(PRODUCER)
  avatarUrl    String?
  telefono     String?
  // Flag de plataforma, transversal a cualquier Organizacion — ver CLAUDE.md §2.3
  // y docs/REQUERIMIENTOS.md ADR-004. No se modela como rol dentro de una org.
  esSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fincas         Finca[]
  compradores    Comprador[]
  chatMessages   ChatMessage[]
  preferences    UserPreferences?
  gastos         Gasto[]
  presupuestos   Presupuesto[]
  membresias     Membresia[]
  fincaAccesos   FincaAcceso[]
  inversionistas Inversionista[]
  enlacesCreados EnlaceCompartido[]

  @@map("users")
}

enum UserRole {
  PRODUCER
  ADVISOR
  BUYER
  ADMIN
}

// ─── ORGANIZATIONS / TENANCY ────────────────────────────────────────────────
// Límite de tenant/facturación, por encima de Finca. Ver CLAUDE.md §2.1 y
// docs/REQUERIMIENTOS.md ADR-001. Fase 0 del roadmap: se crea en paralelo al
// modelo actual (Finca.organizacionId nullable) — el backfill (Fase 0, script
// de migración) asigna 1 Organizacion + Membresia(OWNER) a cada User existente
// sin cambiar comportamiento visible del piloto actual.

model Organizacion {
  id        String           @id @default(cuid())
  nombre    String
  slug      String           @unique
  plan      PlanOrganizacion @default(GRATUITO)
  activa    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  fincas     Finca[]
  membresias Membresia[]

  @@map("organizaciones")
}

enum PlanOrganizacion {
  GRATUITO
  PRODUCTOR
  COOPERATIVA
  ENTERPRISE
}

// User↔Organizacion: quién pertenece a qué tenant y con qué rol.
model Membresia {
  id             String          @id @default(cuid())
  userId         String
  organizacionId String
  rol            RolOrganizacion
  invitadoPorId  String?
  aceptada       Boolean         @default(true)
  // Distinto de `aceptada` (que hoy siempre es true — no hay flujo de
  // invitación por correo, ver CLAUDE.md §2.3). `activa` es el toggle del
  // dueño para suspender el acceso de un colaborador sin borrar el registro
  // (se conserva el historial en vez de un DELETE — ver panel Equipo).
  activa         Boolean         @default(true)
  createdAt      DateTime        @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@unique([userId, organizacionId])
  @@map("membresias")
}

enum RolOrganizacion {
  OWNER
  ADMIN_FINCA
  COLABORADOR
  INVERSIONISTA
  COMPRADOR
}

// Scoping fino: cuando una organización tiene varias fincas y un miembro solo
// debe operar algunas (no se requiere para el OWNER, que accede a todas las
// fincas de su propia organización de forma implícita).
model FincaAcceso {
  id          String   @id @default(cuid())
  userId      String
  fincaId     String
  rol         RolFinca @default(LECTURA)
  creadoPorId String?
  createdAt   DateTime @default(now())
  // Menús/módulos del dashboard visibles y accesibles para este colaborador
  // en esta finca (claves de MODULOS_DASHBOARD, ver src/lib/modulos.ts).
  // Se inicializa con un default según `rol` al crear el acceso y el dueño
  // lo puede personalizar por persona (ver panel Equipo). No reemplaza el
  // RBAC por recurso/acción de authz.ts — es una capa adicional de qué
  // secciones ve/navega, no de qué puede hacer dentro de cada una.
  modulos     String[] @default([])

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  finca Finca @relation(fields: [fincaId], references: [id], onDelete: Cascade)

  @@unique([userId, fincaId])
  @@map("finca_accesos")
}

enum RolFinca {
  ADMIN
  OPERARIO
  LECTURA
}

// ─── FARMS / FINCAS ───────────────────────────────────────────────────────────

model Finca {
  id             String        @id @default(cuid())
  nombre         String
  municipio      String
  departamento   String
  altitud        Float?
  lat            Float?
  lng            Float?
  areaTotal      Float?
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable durante la migración (Fase 0) — se vuelve NOT NULL tras el backfill.
  organizacionId String?
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lotes        Lote[]
  gastos       Gasto[]
  presupuestos Presupuesto[]
  accesos      FincaAcceso[]
  alertas      AlertaClimatica[]
  compradores  Comprador[]

  @@map("fincas")
}

// ─── LOTS / LOTES ─────────────────────────────────────────────────────────────

model Lote {
  id        String   @id @default(cuid())
  nombre    String
  fincaId   String
  finca     Finca    @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  areaHa    Float
  pendiente Float?
  altitud   Float?
  geoJson   Json?
  lat       Float?
  lng       Float?
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cultivos      Cultivo[]
  jornales      Jornal[]
  gastos        Gasto[]
  analisisSuelo AnalisisSuelo[]

  @@map("lotes")
}

// ─── SOIL ANALYSIS / ANÁLISIS DE SUELO (RF3) ───────────────────────────────────
// Registro opcional de análisis de suelo por lote — pH, materia orgánica, N-P-K,
// textura — consultable desde Cultivos. No reemplaza RequerimientoNutricional
// (dosis de fertilización por etapa fenológica de una FichaTecnica); esto es el
// insumo de diagnóstico (qué tiene el suelo hoy), aquello es la receta (qué
// aplicar). Rangos de referencia para interpretar valores viven en
// src/lib/agronomia/suelo-referencia.ts — son generales (no por cultivo/ficha
// técnica todavía, ver CLAUDE.md §2.2/§4), se lo advierte explícitamente en la UI.
model AnalisisSuelo {
  id              String         @id @default(cuid())
  loteId          String
  lote            Lote           @relation(fields: [loteId], references: [id], onDelete: Cascade)
  fechaMuestreo   DateTime
  ph              Float?
  materiaOrganica Float? // % MO
  nitrogeno       Float? // % N total
  fosforo         Float? // ppm P (Bray II)
  potasio         Float? // meq/100g K
  textura         TexturaSuelo?
  conductividad   Float? // dS/m — salinidad (CE)
  laboratorio     String?
  notas           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("analisis_suelo")
}

enum TexturaSuelo {
  ARENOSO
  FRANCO_ARENOSO
  FRANCO
  FRANCO_ARCILLOSO
  ARCILLOSO
  FRANCO_LIMOSO
  LIMOSO
}

// ─── CROP SPECIES CATALOG / ESPECIES DE CULTIVO (PARAMÉTRICO) ─────────────────
// Tabla de configuración que define las propiedades de cada tipo de cultivo.
// Permite soportar múltiples cultivos (café, cacao, cítricos) sin modificar enums.

model EspecieCultivo {
  id      String  @id @default(cuid())
  slug    String  @unique // "aguacate-hass", "cafe-caturra", "cacao-ccu51"
  nombre  String // "Aguacate Hass"
  familia String? // "Lauraceae", "Rubiaceae"

  // Etapas fenológicas como JSON array — reemplaza el enum para cultivos nuevos
  // Ej: ["PREPARACION","SIEMBRA","ESTABLECIMIENTO","CRECIMIENTO","PRODUCCION","COSECHA"]
  etapas Json // string[]

  // Tipos de registro válidos para esta especie
  // Ej: ["RIEGO","FERTILIZACION","PODA","COSECHA","DESPULPADO","SECADO"]
  tiposRegistro Json // string[]

  // Umbrales climáticos específicos del cultivo
  umbralHelada Float? // °C mínimo antes de daño
  umbralCalor  Float? // °C máximo antes de estrés
  lluviaMaxMm  Float? // mm/día para alerta
  vientoMaxKmh Float? // km/h para alerta

  // Ciclo productivo
  cicloMesesPrimeraCosecha Int? // Meses desde siembra hasta primera cosecha
  produccionKgArbolAnual   Float? // kg promedio por árbol/año en plena producción

  // Rango altitudinal óptimo (msnm)
  altitudMin Int?
  altitudMax Int?

  // Condiciones climáticas óptimas
  tempOptMin     Float? // °C mínimo óptimo
  tempOptMax     Float? // °C máximo óptimo
  precipAnualMin Float? // mm/año mínimo
  precipAnualMax Float? // mm/año máximo

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cultivos   Cultivo[]
  variedades Variedad[]

  @@map("especies_cultivo")
}

// ─── MOTOR DE FICHAS TÉCNICAS (PARAMÉTRICO, VERSIONADO) ───────────────────────
// Evoluciona EspecieCultivo (arriba) sin reemplazarlo — ver CLAUDE.md §2.2 y
// docs/REQUERIMIENTOS.md §4.2 / ADR-002. Cada EspecieCultivo hoy ya representa
// una combinación especie+variedad (ej. "Aguacate Hass"), sembrada en
// prisma/seed-especies.ts; el script prisma/migrar-fichas-tecnicas.ts crea,
// por cada una, exactamente 1 Variedad + 1 FichaTecnica v1 PUBLICADA.
//
// Un Cultivo se PINEA a una versión concreta (fichaTecnicaId) al crearse —
// republicar una ficha no altera retroactivamente cultivos ya en curso.

model Variedad {
  id        String  @id @default(cuid())
  especieId String
  nombre    String // "Hass", "Caturra", "CCN-51"
  slug      String
  activo    Boolean @default(true)

  especie  EspecieCultivo @relation(fields: [especieId], references: [id], onDelete: Cascade)
  fichas   FichaTecnica[]
  cultivos Cultivo[]

  @@unique([especieId, slug])
  @@map("variedades")
}

model FichaTecnica {
  id           String      @id @default(cuid())
  variedadId   String
  version      Int         @default(1)
  estado       EstadoFicha @default(BORRADOR)
  publicadaEn  DateTime?
  // Sin FK — mismo patrón laxo que Membresia.invitadoPorId; se resuelve cuando
  // exista un flujo real de Super Admin (Fase 0/2) que lo popule.
  creadoPorId  String?
  notasVersion String?

  altitudMinM             Int?
  altitudMaxM             Int?
  tempMinC                Float?
  tempMaxC                Float?
  humedadMinPct           Float?
  humedadMaxPct           Float?
  phMin                   Float?
  phMax                   Float?
  precipitacionAnualMinMm Int?
  precipitacionAnualMaxMm Int?

  densidadPlantasHaMin Int?
  densidadPlantasHaMax Int?
  distanciaSiembraM    String?
  cicloProductivoMeses Int?
  vidaUtilAnios        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variedad        Variedad               @relation(fields: [variedadId], references: [id], onDelete: Cascade)
  etapas          EtapaFenologica[]
  plagas          PlagaEnfermedad[]
  costosRef       CostoReferencia[]
  curvaProduccion PuntoCurvaProduccion[]
  cultivos        Cultivo[]

  @@unique([variedadId, version])
  @@map("fichas_tecnicas")
}

enum EstadoFicha {
  BORRADOR
  PUBLICADA
  ARCHIVADA
}

model EtapaFenologica {
  id              String  @id @default(cuid())
  fichaId         String
  orden           Int
  nombre          String
  duracionDiasMin Int?
  duracionDiasMax Int?
  descripcion     String?

  ficha       FichaTecnica               @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  actividades ActividadCalendario[]
  nutrientes  RequerimientoNutricional[]
  planesRiego PlanRiego[]

  @@unique([fichaId, orden])
  @@map("etapas_fenologicas")
}

model ActividadCalendario {
  id                String       @id @default(cuid())
  etapaId           String
  nombre            String
  tipoRegistro      TipoRegistro // reutiliza el enum existente de RegistroCultivo
  diaInicioRelativo Int
  diaFinRelativo    Int?
  frecuenciaDias    Int?
  obligatoria       Boolean      @default(false)
  descripcion       String?

  etapa EtapaFenologica @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  @@map("actividades_calendario")
}

model RequerimientoNutricional {
  id                   String  @id @default(cuid())
  etapaId              String
  nutriente            String
  cantidadGramosPlanta Float?
  unidad               String  @default("g/planta/aplicación")
  frecuenciaDias       Int?
  fuenteRecomendada    String?

  etapa EtapaFenologica @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  @@map("requerimientos_nutricionales")
}

model PlanRiego {
  id                String  @id @default(cuid())
  etapaId           String
  litrosPlantaDia   Float?
  frecuenciaDias    Int?
  metodoRecomendado String?

  etapa EtapaFenologica @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  @@map("planes_riego")
}

model PlagaEnfermedad {
  id                 String              @id @default(cuid())
  fichaId            String
  nombre             String
  tipo               TipoPlagaEnfermedad
  sintomas           String?
  imagenesRef        String[] // catálogo visual base para diagnóstico IA (RF15)
  umbralAlerta       Json? // condiciones climáticas que disparan riesgo (RF17)
  manejoRecomendado  String?
  etapasSusceptibles Int[] // ordenes de EtapaFenologica afectadas

  ficha FichaTecnica @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  @@map("plagas_enfermedades")
}

enum TipoPlagaEnfermedad {
  PLAGA
  ENFERMEDAD
  DEFICIENCIA_NUTRICIONAL
}

model CostoReferencia {
  id             String         @id @default(cuid())
  fichaId        String
  categoria      CategoriaGasto // reutiliza el enum existente de Gasto
  etapaOrden     Int?
  montoPorHa     Float?
  montoPorPlanta Float?
  frecuencia     String?
  descripcion    String?

  ficha FichaTecnica @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  @@map("costos_referencia")
}

model PuntoCurvaProduccion {
  id                  String @id @default(cuid())
  fichaId             String
  anioProduccion      Int
  kgPorPlantaEsperado Float?
  kgPorHaEsperado     Float?

  ficha FichaTecnica @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  @@unique([fichaId, anioProduccion])
  @@map("curva_produccion")
}

// ─── CROPS / CULTIVOS ─────────────────────────────────────────────────────────

model Cultivo {
  id                String          @id @default(cuid())
  loteId            String
  lote              Lote            @relation(fields: [loteId], references: [id], onDelete: Cascade)
  especie           String          @default("Aguacate")
  variedad          String          @default("Hass")
  especieId         String?
  especieCultivo    EspecieCultivo? @relation(fields: [especieId], references: [id])
  // Motor de fichas técnicas (Fase 1) — pinneado a una versión concreta al
  // crear el cultivo; ver CLAUDE.md §2.2 y docs/REQUERIMIENTOS.md ADR-002.
  // Nombrado "variedadCatalogo" (no "variedad") porque ese nombre ya lo usa
  // el campo legacy de texto libre `variedad` de arriba.
  variedadId        String?
  variedadCatalogo  Variedad?       @relation(fields: [variedadId], references: [id])
  fichaTecnicaId    String?
  fichaTecnica      FichaTecnica?   @relation(fields: [fichaTecnicaId], references: [id])
  fechaSiembra      DateTime?
  cantidadPlantas   Int?
  densidadHa        Int?
  etapa             EtapaCultivo    @default(PREPARACION)
  estado            EstadoCultivo   @default(ACTIVO)
  notas             String?
  portainjerto      String?
  proveedorMaterial String?
  sistemaSiembra    String?
  distanciaSiembra  String?
  observaciones     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  registros   RegistroCultivo[]
  gastos      Gasto[]
  ingresos    Ingreso[]
  jornales    Jornal[]
  inversiones InversionCultivo[]
  alertas     AlertaClimatica[]
  enlaces     EnlaceCompartido[]

  @@map("cultivos")
}

enum EtapaCultivo {
  PREPARACION
  SIEMBRA
  ESTABLECIMIENTO
  CRECIMIENTO
  PRODUCCION
  COSECHA
}

enum EstadoCultivo {
  ACTIVO
  PAUSADO
  FINALIZADO
}

// ─── CROP LOGS / REGISTROS ────────────────────────────────────────────────────

model RegistroCultivo {
  id          String       @id @default(cuid())
  cultivoId   String
  cultivo     Cultivo      @relation(fields: [cultivoId], references: [id], onDelete: Cascade)
  tipo        TipoRegistro
  descripcion String
  fecha       DateTime     @default(now())
  imagenes    String[]
  datos       Json?
  // Bidirectional sync: optional 1:1 link to financial records
  gastoId     String?      @unique
  gasto       Gasto?       @relation(fields: [gastoId], references: [id])
  ingresoId   String?      @unique
  ingreso     Ingreso?     @relation(fields: [ingresoId], references: [id])
  createdAt   DateTime     @default(now())

  @@map("registros_cultivo")
}

enum TipoRegistro {
  SIEMBRA
  RIEGO
  FERTILIZACION
  PODA
  TRATAMIENTO_PLAGAS
  COSECHA
  OBSERVACION
  INSPECCION
  ALERTA
}

// ─── EXPENSES / GASTOS ────────────────────────────────────────────────────────

model Gasto {
  id             String         @id @default(cuid())
  userId         String
  fincaId        String
  loteId         String?
  cultivoId      String?
  concepto       String
  categoria      CategoriaGasto
  subcategoria   String?
  monto          Float
  cantidad       Float?
  unidad         String?
  precioUnitario Float?
  proveedor      String?
  numeroFactura  String?
  tipoGasto      TipoGasto      @default(VARIABLE)
  fecha          DateTime       @default(now())
  notas          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  finca   Finca    @relation(fields: [fincaId], references: [id])
  lote    Lote?    @relation(fields: [loteId], references: [id])
  cultivo Cultivo? @relation(fields: [cultivoId], references: [id])

  // Back-relation: optional link from registro de cultivo
  registro RegistroCultivo?

  @@map("gastos")
}

enum TipoGasto {
  FIJO
  VARIABLE
  INVERSION
}

// ─── BUDGET / PRESUPUESTO ─────────────────────────────────────────────────────

model Presupuesto {
  id            String         @id @default(cuid())
  userId        String
  fincaId       String
  anio          Int
  categoria     CategoriaGasto
  montoPlaneado Float
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  finca Finca @relation(fields: [fincaId], references: [id])

  @@unique([fincaId, anio, categoria])
  @@map("presupuestos")
}

// ─── LABOR / JORNALES ─────────────────────────────────────────────────────────
// Registro de mano de obra — mayor costo operativo en el campo colombiano.
// Se relaciona con finanzas como gasto automático categoría MANO_OBRA.

model Jornal {
  id              String   @id @default(cuid())
  cultivoId       String?
  cultivo         Cultivo? @relation(fields: [cultivoId], references: [id])
  loteId          String?
  lote            Lote?    @relation(fields: [loteId], references: [id])
  fecha           DateTime @default(now())
  operario        String // Nombre del trabajador
  horasTrabajadas Float    @default(8) // Horas del jornal (default: día completo)
  valorDia        Float // Tarifa día completa en COP (ej: $50.000)
  actividad       String // "Fumigada", "Abonada", "Limpia", "Riego manual"
  descripcion     String? // Detalles adicionales
  imagen          String?  @db.Text // Base64 data URL or external URL
  loteArea        String? // Si aplica a un área específica del lote
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("jornales")
}

enum CategoriaGasto {
  INSUMOS
  MANO_OBRA
  MAQUINARIA
  AGUA_RIEGO
  TRANSPORTE
  CERTIFICACIONES
  TIERRA
  SEMILLAS_PLANTULAS
  HERRAMIENTAS
  ENERGIA
  OTROS
}

// ─── INCOME / INGRESOS ────────────────────────────────────────────────────────

model Ingreso {
  id          String     @id @default(cuid())
  cultivoId   String?
  cultivo     Cultivo?   @relation(fields: [cultivoId], references: [id])
  compradorId String?
  comprador   Comprador? @relation(fields: [compradorId], references: [id])
  concepto    String
  monto       Float
  cantidadKg  Float?
  precioKg    Float?
  fecha       DateTime   @default(now())
  notas       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Back-relation: optional link from registro de cultivo
  registro RegistroCultivo?

  @@map("ingresos")
}

// ─── BUYERS / COMPRADORES ─────────────────────────────────────────────────────

model Comprador {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable durante la migración (mismo patrón que Finca.organizacionId en
  // Fase 0) — se backfillea con prisma/backfill-compradores-finca.ts a la
  // finca del userId creador. Habilita RBAC real (ADMIN_FINCA/COLABORADOR)
  // sobre "comprador", ya contemplado en la matriz de authz.ts pero bloqueado
  // hasta ahora porque el modelo solo tenía userId (deuda técnica, Fase 2).
  fincaId      String?
  finca        Finca?        @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  nombre       String
  tipo         TipoComprador
  ciudad       String
  departamento String?
  contacto     String?
  email        String?
  telefono     String?
  capacidadTon Float?
  precioKg     Float?
  notas        String?
  estado       String        @default("ACTIVO")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  ingresos Ingreso[]
  enlaces  EnlaceCompartido[]

  @@map("compradores")
}

enum TipoComprador {
  COOPERATIVA
  EXPORTADOR
  MAYORISTA
  SUPERMERCADO
  PLAZA_MERCADO
  RESTAURANTE
  OTRO
}

// ─── INVESTORS / INVERSIONISTAS ────────────────────────────────────────────
// Fase 3 (parcial) — ver CLAUDE.md §2.5 y docs/REQUERIMIENTOS.md ADR-003.
// Mismo patrón que Comprador: un contacto gestionado por el productor
// (userId = dueño de la finca que lo registra), NO un User con login propio
// — el rol INVERSIONISTA con sesión y acceso scoped queda para cuando el
// RBAC real (Fase 2) esté enforced en las rutas. Se puede agregar más
// adelante un `cuentaUserId String?` opcional, igual que está previsto para
// Comprador.userId en el gap analysis, sin romper este modelo.

model Inversionista {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre    String
  email     String?
  telefono  String?
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inversiones InversionCultivo[]

  @@map("inversionistas")
}

// Aporte de un inversionista a un cultivo ESPECÍFICO (no a la finca completa)
// — requisito de negocio explícito: un inversionista puede financiar el lote
// de cacao sin tener visibilidad ni participación en el de café.
model InversionCultivo {
  id                      String          @id @default(cuid())
  cultivoId               String
  cultivo                 Cultivo         @relation(fields: [cultivoId], references: [id], onDelete: Cascade)
  inversionistaId         String
  inversionista           Inversionista   @relation(fields: [inversionistaId], references: [id], onDelete: Cascade)
  montoAportado           Float
  fechaAporte             DateTime        @default(now())
  moneda                  String          @default("COP")
  porcentajeParticipacion Float
  condiciones             String?
  estado                  EstadoInversion @default(ACTIVA)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  retornos RetornoInversion[]

  @@map("inversiones_cultivo")
}

enum EstadoInversion {
  ACTIVA
  RETIRADA
  FINALIZADA
}

// Historial de retornos entregados al inversionista — separado de Ingreso
// (que es la venta del cultivo) porque un retorno es la distribución de
// utilidad, no necesariamente 1:1 con una venta puntual.
model RetornoInversion {
  id          String           @id @default(cuid())
  inversionId String
  inversion   InversionCultivo @relation(fields: [inversionId], references: [id], onDelete: Cascade)
  monto       Float
  fecha       DateTime         @default(now())
  concepto    String?
  createdAt   DateTime         @default(now())

  @@map("retornos_inversion")
}

// ─── WEATHER ALERTS / ALERTAS CLIMÁTICAS ─────────────────────────────────────

model AlertaClimatica {
  id          String     @id @default(cuid())
  tipo        TipoAlerta
  titulo      String
  descripcion String
  severidad   Severidad  @default(MEDIA)
  fechaInicio DateTime
  fechaFin    DateTime?
  activa      Boolean    @default(true)
  leida       Boolean    @default(false)
  datos       Json?
  municipio   String?
  createdAt   DateTime   @default(now())

  // Aislamiento por finca/cultivo — antes este modelo no tenía dueño y
  // GET /api/alertas devolvía TODO a cualquier usuario autenticado. Ambos
  // opcionales: las alertas climáticas (HELADA, LLUVIA_EXCESIVA, etc.) son
  // a nivel finca; las de PLAGA (motor de fichas técnicas, Fase 5) son
  // específicas de un cultivo. Ver prisma/backfill-alertas-finca.ts.
  fincaId   String?
  finca     Finca?   @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  cultivoId String?
  cultivo   Cultivo? @relation(fields: [cultivoId], references: [id], onDelete: Cascade)

  @@map("alertas_climaticas")
}

enum TipoAlerta {
  HELADA
  LLUVIA_EXCESIVA
  SEQUIA
  VIENTO_FUERTE
  TEMPERATURA_ALTA
  GRANIZO
  PLAGA
  // Recordatorio proactivo de manejo (riego/fertilización/poda/inspección)
  // proyectado desde ActividadCalendario de la ficha técnica del cultivo —
  // no reacciona a clima, reacciona al calendario agronómico. Ver RF17/RF18
  // en docs/REQUERIMIENTOS.md ("brecha funcional real, no solo de datos").
  ACTIVIDAD
  OTRO
}

enum Severidad {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

// ─── AI CHAT / HISTORIAL IA ───────────────────────────────────────────────────

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String   @db.Text
  tokens    Int?
  createdAt DateTime @default(now())

  @@map("chat_messages")
}

enum ChatRole {
  USER
  ASSISTANT
}

// ─── USER PREFERENCES ─────────────────────────────────────────────────────────

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tempMinAlert Float @default(12)
  tempMaxAlert Float @default(32)
  rainAlertMm  Float @default(30)
  windAlertKmh Float @default(40)
  droughtDays  Int   @default(5)

  lat       Float  @default(7.9273)
  lng       Float  @default(-72.5078)
  municipio String @default("Norte de Santander")

  emailAlerts Boolean @default(true)
  pushAlerts  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

// ─── PORTAL DE COMPRADORES (Fase 4) ────────────────────────────────────────────
// Enlace de solo lectura, sin necesidad de cuenta, para que un comprador
// externo vea el estado de un cultivo (etapa, proyección de cosecha, fotos
// recientes) sin exponer datos financieros/de costos de la finca — ver
// CLAUDE.md §2 y docs/REQUERIMIENTOS.md §9 (Fase 4, ADR pendiente de
// formalizar). `token` es el identificador público (alta entropía,
// generado con crypto.randomBytes — no usar `id` en la URL pública).

model EnlaceCompartido {
  id          String  @id @default(cuid())
  token       String  @unique
  cultivoId   String
  cultivo     Cultivo @relation(fields: [cultivoId], references: [id], onDelete: Cascade)
  compradorId String?
  comprador   Comprador? @relation(fields: [compradorId], references: [id], onDelete: SetNull)
  creadoPorId String
  creadoPor   User    @relation(fields: [creadoPorId], references: [id])

  nota     String? // mensaje opcional del productor, visible en el portal público
  expiraEn DateTime?
  revocado Boolean   @default(false)

  vistas        Int       @default(0)
  ultimaVistaEn DateTime?

  createdAt DateTime @default(now())

  @@map("enlaces_compartidos")
}
