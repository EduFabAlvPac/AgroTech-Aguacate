generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ────────────────────────────────────────────────────────────────────

// Fase 3 de ADR-006 — qué conjunto de componentes renderizan las rutas
// reales: los de modo completo (Fase 1) o los de modo simple (Fase 2).
// AUTO se resuelve solo por ancho de pantalla por ahora (cookie, ver
// src/lib/vista-preferida.ts) — el criterio de rol (Fase 4) depende del
// RBAC real, todavía no está listo; agregarlo será un cambio dentro de esa
// función de resolución, no de este enum ni del switch.
enum VistaPreferida {
  SIMPLE
  COMPLETA
  AUTO
}

// Perfil de experiencia — ortogonal a VistaPreferida (que es una preferencia
// de UI que el propio usuario cambia libremente) y a UserRole/Membresia (rol
// de negocio). CAMPESINO es una asignación de administrador/asesor al crear
// la cuenta, no algo que el usuario elija ni pueda cambiar desde su perfil —
// ver docs/paridad-modo-simple.md y CLAUDE.md §5 (Campesino, ADR-006 fase
// posterior). resolverModoApp()/resolverModoRuta() no se tocan: un usuario
// CAMPESINO se desvía a /campesino ANTES de llegar a esa resolución (ver
// src/lib/experiencia.ts).
enum ExperienciaApp {
  ESTANDAR
  CAMPESINO
}

model User {
  id                       String         @id @default(cuid())
  email                    String         @unique
  name                     String?
  password                 String?
  role                     UserRole       @default(PRODUCER)
  avatarUrl                String?
  // @unique agregado para el login "modo Campesino" (solo celular, sin
  // contraseña) — antes era texto de contacto libre. Verificado sin
  // duplicados en dev antes de aplicar; revisar Neon prod de la misma forma
  // antes de pushear (múltiples NULL sí conviven bajo @unique en Postgres).
  telefono                 String?        @unique
  // Asignación de administrador/asesor, no preferencia del usuario — ver
  // ExperienciaApp arriba.
  experiencia              ExperienciaApp @default(ESTANDAR)
  // Quién creó esta cuenta Campesino (el OWNER que la dio de alta desde
  // Equipo) — necesario porque una cuenta Campesino NO tiene Membresia/
  // Organizacion (decisión de producto, sin Finca/Lote/Cultivo), así que sin
  // este campo no habría forma de saber a qué OWNER pertenece cada una y
  // Equipo tendría que listar TODAS las cuentas Campesino de la plataforma
  // (fuga cross-tenant — ver CLAUDE.md §7). Null para cuentas no-Campesino.
  creadoPorId              String?
  // Login Campesino seguro — true = este celular solo entra desde un
  // dispositivo vinculado con un código que generó el dueño (ver
  // DispositivoConfianza/CodigoVinculacion). Default false a propósito: las
  // cuentas Campesino que ya existían siguen entrando como siempre hasta que
  // el dueño les genere un código (migración no disruptiva); las nuevas nacen
  // en true desde crearCuentaCampesino().
  requiereVinculacion      Boolean        @default(false)
  // Organización en la que se creó esta cuenta Campesino — permite contar los
  // asociados POR organización (límite del trial de una cooperativa) cuando un
  // mismo dueño tiene más de una. Null en las cuentas anteriores: se atribuyen
  // al dueño que las creó (todos los dueños de entonces tenían una sola
  // organización). Sin FK a propósito: es un dato de contexto, no una relación
  // que deba bloquear/arrastrar borrados.
  creadoEnOrganizacionId   String?
  // "Mis cultivos" (modo Campesino, /campesino/cultivos) — qué especies dice
  // manejar, guardado con un toque (sin formulario de Finca/Lote/fecha de
  // siembra, decisión de producto ya tomada). Valores = slug de
  // EspecieCampesinoSlug (src/lib/campesino-especies.ts), ej. "cafe-caturra".
  // String[] simple en vez de tabla aparte: son como máximo 4 valores fijos,
  // no amerita un modelo relacional propio.
  cultivosSeleccionados    String[]       @default([])
  // Geolocalización real del navegador (modo Campesino, /campesino/clima) —
  // reemplaza las coordenadas fijas de Ocaña por defecto (src/lib/weather.ts)
  // cuando el usuario dio permiso. Se pide una vez por sesión de pestaña
  // (ver UbicacionCampesinoClient.tsx), no en cada carga de página — la
  // ubicación de una finca no cambia día a día. Null = todavía sin permiso
  // o lo negó, cae al valor por defecto sin romper nada.
  ubicacionLat             Float?
  ubicacionLng             Float?
  ubicacionActualizadaEn   DateTime?
  // Opcional con default a nivel de base de datos — Fase 3 de ADR-006.
  // Nunca NOT NULL sin default: alterar una tabla con filas existentes en
  // Neon sin default fuerza un --force-reset (ver CLAUDE.md/lecciones de
  // Fase 1). Postgres rellena AUTO en todas las filas existentes al aplicar
  // el push, verificado antes de dar por segura la migración.
  vistaPreferida           VistaPreferida @default(AUTO)
  // Flag de plataforma, transversal a cualquier Organizacion — ver CLAUDE.md §2.3
  // y docs/REQUERIMIENTOS.md ADR-004. No se modela como rol dentro de una org.
  esSuperAdmin             Boolean        @default(false)
  // Fuerza bruta de login (OWASP A07) — antes authorize() no llevaba ningún
  // contador, así que un ataque de diccionario contra /api/auth podía
  // reintentar sin límite. Se resetea a 0 en un login exitoso.
  failedLoginAttempts      Int            @default(0)
  lockedUntil              DateTime?
  // Ley 1581 de 2012 (Colombia) — derecho de supresión. Se llena cuando el
  // usuario pide eliminar su cuenta pero el borrado inmediato no es seguro
  // (es OWNER de una organización con otros miembros activos que dependen
  // de esos datos — ver src/lib/cuenta-datos.ts). Queda como solicitud
  // pendiente de revisión manual en vez de arriesgar un cascade que borre
  // datos de terceros sin su consentimiento.
  eliminacionSolicitadaEn  DateTime?
  // Self-signup (Fase 1 SaaS, Tanda 2) — null = correo sin verificar, no
  // puede loguearse (ver authorize() en auth.ts). Cuentas creadas ANTES de
  // esta tanda se backfillean a `createdAt` en el propio db push (ver
  // migración manual documentada), nunca se bloquean retroactivamente.
  emailVerificado          DateTime?
  tokenVerificacion        String?        @unique
  tokenVerificacionExpira  DateTime?
  tokenResetPassword       String?        @unique
  tokenResetPasswordExpira DateTime?
  // Ley 1581 — consentimiento informado, timestamp de cuándo aceptó
  // Términos/Privacidad en el registro. Null en cuentas creadas por un
  // admin (Equipo/Campesino), que no pasan por ese formulario.
  terminosAceptadosEn      DateTime?

  // ─── ADR-011 (IAM) — campos aditivos ─────────────────────────────────────────
  // Equivalencias ADR ↔ campos que YA existen arriba (no se duplican):
  //   passwordHash→password · nombreCompleto→name · fotoUrl→avatarUrl ·
  //   celular→telefono · celularVerificadoEn→telefonoVerificadoEn (nuevo) ·
  //   emailVerificadoEn→emailVerificado · bloqueadoHasta→lockedUntil ·
  //   intentosFallidos→failedLoginAttempts · consentimientoDatosEn→terminosAceptadosEn ·
  //   perfilUI→experiencia + vistaPreferida (juntos cubren las 3 experiencias:
  //   Completa / Simple / Campesino; un `perfilUI` de 3 valores perdería "Simple").
  // Ver docs/ADR-011-notas-de-implementacion.md. Ninguno de estos campos lo lee
  // todavía el código: se activan en los Sprints 1-6 del ADR.
  //
  // Método con el que el usuario normalmente entra. Un Campesino hoy entra solo
  // con celular; el Sprint 4 lo pasa a WHATSAPP_MAGIC_LINK. El backfill de los
  // Campesino existentes (metodoAuthPreferido) llega en el Sprint 1.
  metodoAuthPreferido   MetodoAuth @default(EMAIL_PASSWORD)
  telefonoVerificadoEn  DateTime?
  // Cifrado a nivel de aplicación (la gestión de llaves está por definir, Sprint 6).
  documentoIdentidad    String?
  // MFA TOTP — obligatorio para SUPER_ADMIN, ORG_OWNER e INVESTOR (ADR-011 §3).
  mfaHabilitado         Boolean    @default(false)
  mfaSecret             String?
  mfaBackupCodes        String[]   @default([])
  ultimoAccesoEn        DateTime?
  ultimaIpAcceso        String?
  // Versión del aviso de privacidad aceptado (Ley 1581): al cambiar el aviso se
  // pide re-aceptación. Convive con `terminosAceptadosEn` (cuándo aceptó).
  consentimientoVersion String?
  // Soft delete (derecho al olvido, Ley 1581). Distinto de
  // `eliminacionSolicitadaEn` (solicitud pendiente de revisión manual): éste es
  // la baja ya efectuada, que un job purga físicamente a los 30 días.
  eliminadoEn           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  fincas                 Finca[]
  compradores            Comprador[]
  chatMessages           ChatMessage[]
  usoIaDiario            UsoIaDiario[]
  preferences            UserPreferences?
  gastos                 Gasto[]
  presupuestos           Presupuesto[]
  membresias             Membresia[]
  fincaAccesos           FincaAcceso[]
  // Inversionistas que ESTE usuario registró como contacto (dueño de la finca).
  // Relación nombrada porque ADR-011 agrega una segunda hacia Inversionista
  // (`Inversionista.usuarioId`: el inversionista como usuario con login).
  inversionistas         Inversionista[]                @relation("InversionistaDueno")
  inversionistaDe        Inversionista[]                @relation("InversionistaUsuario")
  enlacesCreados         EnlaceCompartido[]
  // ADR-011 (IAM)
  sesiones               Sesion[]
  tokensAuth             TokenAuth[]
  codigosVinculacion     CodigoVinculacion[]
  dispositivosConfianza  DispositivoConfianza[]
  invitacionesEnviadas   Invitacion[]                   @relation("InvitacionesEnviadas")
  impersonacionesSoporte Impersonacion[]                @relation("ImpersonacionSoporte")
  impersonacionesTarget  Impersonacion[]                @relation("ImpersonacionTarget")
  preciosMercadoCreados  PrecioMercado[]
  // Self-relation: qué OWNER creó esta cuenta Campesino / qué cuentas
  // Campesino creó este OWNER — ver comentario de creadoPorId arriba.
  creadoPor              User?                          @relation("CampesinoCreador", fields: [creadoPorId], references: [id], onDelete: SetNull)
  campesinosCreados      User[]                         @relation("CampesinoCreador")
  productosTiendaCreados ProductoTienda[]
  consultasDiagnostico   ConsultaDiagnosticoCampesino[]

  @@map("users")
}

enum UserRole {
  PRODUCER
  ADVISOR
  BUYER
  ADMIN
}

// ─── ORGANIZATIONS / TENANCY ────────────────────────────────────────────────
// Límite de tenant/facturación, por encima de Finca. Ver CLAUDE.md §2.1 y
// docs/REQUERIMIENTOS.md ADR-001. Fase 0 del roadmap: se crea en paralelo al
// modelo actual (Finca.organizacionId nullable) — el backfill (Fase 0, script
// de migración) asigna 1 Organizacion + Membresia(OWNER) a cada User existente
// sin cambiar comportamiento visible del piloto actual.

model Organizacion {
  id        String           @id @default(cuid())
  nombre    String
  slug      String           @unique
  plan      PlanOrganizacion @default(GRATUITO)
  activa    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // ─── ADR-011 (IAM) — capa 2 "Tenant" (aditivo) ──────────────────────────────
  // `Organizacion` ES la `Organization` del ADR (se conserva el nombre en
  // español, igual que Finca/Lote/Cultivo). Las orgs existentes son 1:1 con un
  // productor (backfill de Fase 0), de ahí los defaults INDIVIDUAL / ACTIVA.
  tipo                TipoOrg          @default(INDIVIDUAL)
  nit                 String?          @unique
  paisIso             String           @default("CO")
  ciudad              String?
  departamento        String?
  emailContacto       String?
  celularContacto     String?
  // Estado del plan. `activa` (arriba) se conserva; el Sprint 3 decide si
  // pasa a derivarse de `estadoPlan`/`eliminadoEn`. Facturación completa:
  // ADR-012 (pendiente) — estos campos son la parte "referencial" del ADR-011.
  estadoPlan          EstadoPlan       @default(ACTIVA)
  planIniciadoEn      DateTime?
  planVigenteHasta    DateTime?
  cicloFacturacion    CicloFacturacion @default(MENSUAL)
  // null = ilimitado (Empresarial)
  limiteAsociadosPlan Int?
  limiteFincasPlan    Int?
  limiteUsuariosPlan  Int?
  // Trial del plan Colectivo: 30 días, máx. 5 asociados (ADR-011 §1.1).
  esTrial             Boolean          @default(false)
  trialInicioEn       DateTime?
  trialFinEn          DateTime?
  trialMaxAsociados   Int?             @default(5)
  // Marca blanca (Colectivo/Empresarial)
  logoUrl             String?
  colorPrimario       String?
  configuracion       Json             @default("{}")
  eliminadoEn         DateTime?

  fincas            Finca[]
  membresias        Membresia[]
  plantillasModulos RolModulosDefault[]
  invitaciones      Invitacion[]
  facturacion       Facturacion[]

  @@index([tipo, estadoPlan])
  @@map("organizaciones")
}

// Plantilla de módulos visibles por defecto según el rol de FincaAcceso —
// configurable por el OWNER de cada organización (antes era un default fijo
// en código, ver modulosPorDefecto() en src/lib/modulos.ts, que sigue como
// fallback cuando el dueño no ha personalizado la plantilla de un rol
// todavía). Al invitar/editar a UNA persona en el panel Equipo se sigue
// pudiendo ajustar su acceso puntual — esto es la base de la que parte, no
// un reemplazo de esa personalización por persona.
model RolModulosDefault {
  id             String       @id @default(cuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  rol            RolFinca
  modulos        String[]
  updatedAt      DateTime     @updatedAt

  @@unique([organizacionId, rol])
  @@map("rol_modulos_default")
}

// Es el `PlanTipo` del ADR-011 — un solo enum en vez de dos. Ningún archivo de
// src/ referencia estos valores todavía (0 usos), pero las filas existentes
// tienen GRATUITO por default, así que los 4 originales se CONSERVAN (agregar
// valores a un enum de Postgres es aditivo; quitarlos no). Equivalencias:
// GRATUITO≈SEMILLA_TRIAL · COOPERATIVA≈COLECTIVO · ENTERPRISE≈EMPRESARIAL.
// Precios y detalle comercial: ADR-012 (en curso).
enum PlanOrganizacion {
  // Originales (Fase 0) — deprecados. PRODUCTOR también es un plan del ADR.
  GRATUITO
  PRODUCTOR
  COOPERATIVA
  ENTERPRISE
  // ADR-011
  SEMILLA_TRIAL // trial de 30 días de PRO
  FINCA_PRO
  COLECTIVO // desde 50 asociados
  EMPRESARIAL // cotización
  GERMIAMIGO_INDIVIDUAL // campesino individual con plan pago
  GERMIAMIGO_SEMILLA // campesino individual gratuito
}

// User↔Organizacion: quién pertenece a qué tenant y con qué rol.
model Membresia {
  id             String          @id @default(cuid())
  userId         String
  organizacionId String
  rol            RolOrganizacion
  invitadoPorId  String?
  aceptada       Boolean         @default(true)
  // Distinto de `aceptada` (que hoy siempre es true — no hay flujo de
  // invitación por correo, ver CLAUDE.md §2.3). `activa` es el toggle del
  // dueño para suspender el acceso de un colaborador sin borrar el registro
  // (se conserva el historial en vez de un DELETE — ver panel Equipo).
  activa         Boolean         @default(true)
  createdAt      DateTime        @default(now())

  // ─── ADR-011 (IAM) — capa 3 "Membership" (aditivo) ──────────────────────────
  // `Membresia` ES la `Membership` del ADR. Mientras el cutover no ocurra
  // (Sprints 1-3), `rol`/`aceptada`/`activa` siguen siendo la fuente de verdad
  // y estas columnas quedan como "sombra" que el backfill del Sprint 1 llena:
  //   estado    ← aceptada/activa  (activa=false → SUSPENDIDA, aceptada=false → PENDIENTE)
  //   rolesIam  ← rol, por src/lib/authz/policies.ts::rolLegacyARolIam()
  //   esRolPrimario ← la membresía más antigua de cada usuario
  fincaId          String?
  estado           EstadoMembresia @default(ACTIVA)
  esRolPrimario    Boolean         @default(false)
  // `rolIam` (singular) quedó sin usar a propósito — error de diseño del PR
  // #50: un OWNER de organización INDIVIDUAL es a la vez ORG_OWNER y
  // FARM_OWNER en el modelo nuevo (rolLegacyARolIam() ya devuelve un
  // arreglo), y hoy no se puede modelar como dos filas de Membresia (el
  // @@unique de abajo lo impide hasta el Sprint 3). Se corrige con
  // `rolesIam` (plural). `rolIam` no se borra — mismo criterio que los 4
  // valores viejos de PlanOrganizacion: nunca DROP de algo que ya se envió.
  rolIam           Rol?
  rolesIam         Rol[]           @default([])
  aceptadoEn       DateTime?
  revocadoEn       DateTime?
  revocadoPorId    String?
  motivoRevocacion String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  // Scope de finca para roles FARM_* (null en roles de organización).
  finca        Finca?       @relation(fields: [fincaId], references: [id], onDelete: Cascade)

  // DIFERIDO A SPRINT 3 (a propósito): el ADR pide
  // @@unique([userId, organizacionId, rol, farmId]) para permitir varias
  // membresías de un mismo usuario en una organización. Aquí se conserva el
  // unique actual porque el código lo usa como llave compuesta
  // `userId_organizacionId` (authz.ts y ~12 archivos más); cambiarlo obliga a
  // tocar el login/RBAC. Al hacerlo: con farmId NULL ese unique NO evita
  // duplicados (en Postgres NULL ≠ NULL) → usar una columna centinela
  // (`fincaKey String @default("")`) en vez de un índice parcial con SQL
  // crudo, que `prisma db push` podría eliminar.
  @@unique([userId, organizacionId])
  @@index([organizacionId, rol, estado])
  @@index([userId, estado])
  @@index([fincaId])
  @@map("membresias")
}

enum RolOrganizacion {
  OWNER
  ADMIN_FINCA
  COLABORADOR
  INVERSIONISTA
  COMPRADOR
}

// Scoping fino: cuando una organización tiene varias fincas y un miembro solo
// debe operar algunas (no se requiere para el OWNER, que accede a todas las
// fincas de su propia organización de forma implícita).
model FincaAcceso {
  id          String   @id @default(cuid())
  userId      String
  fincaId     String
  rol         RolFinca @default(LECTURA)
  creadoPorId String?
  createdAt   DateTime @default(now())
  // Menús/módulos del dashboard visibles y accesibles para este colaborador
  // en esta finca (claves de MODULOS_DASHBOARD, ver src/lib/modulos.ts).
  // Se inicializa con un default según `rol` al crear el acceso y el dueño
  // lo puede personalizar por persona (ver panel Equipo). No reemplaza el
  // RBAC por recurso/acción de authz.ts — es una capa adicional de qué
  // secciones ve/navega, no de qué puede hacer dentro de cada una.
  modulos     String[] @default([])

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  finca Finca @relation(fields: [fincaId], references: [id], onDelete: Cascade)

  @@unique([userId, fincaId])
  @@map("finca_accesos")
}

enum RolFinca {
  ADMIN
  OPERARIO
  LECTURA
}

// ─── FARMS / FINCAS ───────────────────────────────────────────────────────────

model Finca {
  id             String        @id @default(cuid())
  nombre         String
  municipio      String
  departamento   String
  altitud        Float?
  lat            Float?
  lng            Float?
  areaTotal      Float?
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable durante la migración (Fase 0) — se vuelve NOT NULL tras el backfill.
  organizacionId String?
  organizacion   Organizacion? @relation(fields: [organizacionId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lotes        Lote[]
  gastos       Gasto[]
  presupuestos Presupuesto[]
  accesos      FincaAcceso[]
  alertas      AlertaClimatica[]
  compradores  Comprador[]
  polizas      PolizaSeguro[]
  siniestros   Siniestro[]
  // ADR-011: membresías con scope de esta finca (roles FARM_*) e invitaciones
  // pendientes a ella. `accesos` (FincaAcceso) sigue vigente hasta el Sprint 3.
  membresias   Membresia[]
  invitaciones Invitacion[]

  @@map("fincas")
}

// ─── LOTS / LOTES ─────────────────────────────────────────────────────────────

model Lote {
  id        String   @id @default(cuid())
  nombre    String
  fincaId   String
  finca     Finca    @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  areaHa    Float
  pendiente Float?
  altitud   Float?
  geoJson   Json?
  lat       Float?
  lng       Float?
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cultivos      Cultivo[]
  jornales      Jornal[]
  gastos        Gasto[]
  analisisSuelo AnalisisSuelo[]

  @@map("lotes")
}

// ─── SOIL ANALYSIS / ANÁLISIS DE SUELO (RF3) ───────────────────────────────────
// Registro opcional de análisis de suelo por lote — pH, materia orgánica, N-P-K,
// textura — consultable desde Cultivos. No reemplaza RequerimientoNutricional
// (dosis de fertilización por etapa fenológica de una FichaTecnica); esto es el
// insumo de diagnóstico (qué tiene el suelo hoy), aquello es la receta (qué
// aplicar). Rangos de referencia para interpretar valores viven en
// src/lib/agronomia/suelo-referencia.ts — son generales (no por cultivo/ficha
// técnica todavía, ver CLAUDE.md §2.2/§4), se lo advierte explícitamente en la UI.
model AnalisisSuelo {
  id              String        @id @default(cuid())
  loteId          String
  lote            Lote          @relation(fields: [loteId], references: [id], onDelete: Cascade)
  fechaMuestreo   DateTime
  ph              Float?
  materiaOrganica Float? // % MO
  nitrogeno       Float? // % N total
  fosforo         Float? // ppm P (Bray II)
  potasio         Float? // meq/100g K
  textura         TexturaSuelo?
  conductividad   Float? // dS/m — salinidad (CE)
  laboratorio     String?
  notas           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // ── Ciclo de vida del cultivo (PR «suelo por cultivo») ──────────────────
  // Un lote puede alojar varios cultivos a lo largo de los años y un cultivo
  // se analiza varias veces en su ciclo: el análisis sigue perteneciendo al
  // LOTE (loteId, requerido — el suelo es del lote) pero puede atribuirse a un
  // cultivo y a la etapa en que se muestreó. SetNull: borrar el cultivo no
  // borra el análisis, queda como historial del lote.
  cultivoId     String?
  cultivo       Cultivo?      @relation(fields: [cultivoId], references: [id], onDelete: SetNull)
  etapa         EtapaCultivo? // etapa del cultivo al muestrear (foto del momento)
  profundidadCm Int?

  // ── Parámetros habituales de un informe de laboratorio ──────────────────
  // Unidades como en los informes colombianos: bases e Al en meq/100g,
  // S y micronutrientes en ppm (mg/kg).
  calcio    Float? // meq/100g
  magnesio  Float? // meq/100g
  sodio     Float? // meq/100g
  aluminio  Float? // meq/100g (acidez intercambiable)
  cic       Float? // meq/100g (capacidad de intercambio catiónico)
  azufre    Float? // ppm
  boro      Float? // ppm
  hierro    Float? // ppm
  manganeso Float? // ppm
  zinc      Float? // ppm
  cobre     Float? // ppm
  // Fotos del informe del laboratorio (comprimidas, como las de los registros).
  imagenes  String[] @default([])

  @@index([cultivoId])
  @@map("analisis_suelo")
}

enum TexturaSuelo {
  ARENOSO
  FRANCO_ARENOSO
  FRANCO
  FRANCO_ARCILLOSO
  ARCILLOSO
  FRANCO_LIMOSO
  LIMOSO
}

// ─── CROP SPECIES CATALOG / ESPECIES DE CULTIVO (PARAMÉTRICO) ─────────────────
// Tabla de configuración que define las propiedades de cada tipo de cultivo.
// Permite soportar múltiples cultivos (café, cacao, cítricos) sin modificar enums.

model EspecieCultivo {
  id      String  @id @default(cuid())
  slug    String  @unique // "aguacate-hass", "cafe-caturra", "cacao-ccu51"
  nombre  String // "Aguacate Hass"
  familia String? // "Lauraceae", "Rubiaceae"

  // Etapas fenológicas como JSON array — reemplaza el enum para cultivos nuevos
  // Ej: ["PREPARACION","SIEMBRA","ESTABLECIMIENTO","CRECIMIENTO","PRODUCCION","COSECHA"]
  etapas Json // string[]

  // Tipos de registro válidos para esta especie
  // Ej: ["RIEGO","FERTILIZACION","PODA","COSECHA","DESPULPADO","SECADO"]
  tiposRegistro Json // string[]

  // Umbrales climáticos específicos del cultivo
  umbralHelada Float? // °C mínimo antes de daño
  umbralCalor  Float? // °C máximo antes de estrés
  lluviaMaxMm  Float? // mm/día para alerta
  vientoMaxKmh Float? // km/h para alerta

  // Ciclo productivo
  cicloMesesPrimeraCosecha Int? // Meses desde siembra hasta primera cosecha
  produccionKgArbolAnual   Float? // kg promedio por árbol/año en plena producción

  // Rango altitudinal óptimo (msnm)
  altitudMin Int?
  altitudMax Int?

  // Condiciones climáticas óptimas
  tempOptMin     Float? // °C mínimo óptimo
  tempOptMax     Float? // °C máximo óptimo
  precipAnualMin Float? // mm/año mínimo
  precipAnualMax Float? // mm/año máximo

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cultivos   Cultivo[]
  variedades Variedad[]

  @@map("especies_cultivo")
}

// ─── MOTOR DE FICHAS TÉCNICAS (PARAMÉTRICO, VERSIONADO) ───────────────────────
// Evoluciona EspecieCultivo (arriba) sin reemplazarlo — ver CLAUDE.md §2.2 y
// docs/REQUERIMIENTOS.md §4.2 / ADR-002. Cada EspecieCultivo hoy ya representa
// una combinación especie+variedad (ej. "Aguacate Hass"), sembrada en
// prisma/seed-especies.ts; el script prisma/migrar-fichas-tecnicas.ts crea,
// por cada una, exactamente 1 Variedad + 1 FichaTecnica v1 PUBLICADA.
//
// Un Cultivo se PINEA a una versión concreta (fichaTecnicaId) al crearse —
// republicar una ficha no altera retroactivamente cultivos ya en curso.

model Variedad {
  id        String  @id @default(cuid())
  especieId String
  nombre    String // "Hass", "Caturra", "CCN-51"
  slug      String
  activo    Boolean @default(true)

  especie  EspecieCultivo @relation(fields: [especieId], references: [id], onDelete: Cascade)
  fichas   FichaTecnica[]
  cultivos Cultivo[]

  @@unique([especieId, slug])
  @@map("variedades")
}

model FichaTecnica {
  id           String      @id @default(cuid())
  variedadId   String
  version      Int         @default(1)
  estado       EstadoFicha @default(BORRADOR)
  publicadaEn  DateTime?
  // Sin FK — mismo patrón laxo que Membresia.invitadoPorId; se resuelve cuando
  // exista un flujo real de Super Admin (Fase 0/2) que lo popule.
  creadoPorId  String?
  notasVersion String?

  altitudMinM             Int?
  altitudMaxM             Int?
  tempMinC                Float?
  tempMaxC                Float?
  humedadMinPct           Float?
  humedadMaxPct           Float?
  phMin                   Float?
  phMax                   Float?
  precipitacionAnualMinMm Int?
  precipitacionAnualMaxMm Int?

  densidadPlantasHaMin Int?
  densidadPlantasHaMax Int?
  distanciaSiembraM    String?
  cicloProductivoMeses Int?
  vidaUtilAnios        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variedad        Variedad               @relation(fields: [variedadId], references: [id], onDelete: Cascade)
  etapas          EtapaFenologica[]
  plagas          PlagaEnfermedad[]
  costosRef       CostoReferencia[]
  curvaProduccion PuntoCurvaProduccion[]
  cultivos        Cultivo[]

  @@unique([variedadId, version])
  @@map("fichas_tecnicas")
}

enum EstadoFicha {
  BORRADOR
  PUBLICADA
  ARCHIVADA
}

model EtapaFenologica {
  id              String  @id @default(cuid())
  fichaId         String
  orden           Int
  nombre          String
  duracionDiasMin Int?
  duracionDiasMax Int?
  descripcion     String?

  ficha       FichaTecnica               @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  actividades ActividadCalendario[]
  nutrientes  RequerimientoNutricional[]
  planesRiego PlanRiego[]

  @@unique([fichaId, orden])
  @@map("etapas_fenologicas")
}

model ActividadCalendario {
  id                String       @id @default(cuid())
  etapaId           String
  nombre            String
  tipoRegistro      TipoRegistro // reutiliza el enum existente de RegistroCultivo
  diaInicioRelativo Int
  diaFinRelativo    Int?
  frecuenciaDias    Int?
  obligatoria       Boolean      @default(false)
  descripcion       String?

  etapa EtapaFenologica @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  @@map("actividades_calendario")
}

model RequerimientoNutricional {
  id                   String  @id @default(cuid())
  etapaId              String
  nutriente            String
  cantidadGramosPlanta Float?
  unidad               String  @default("g/planta/aplicación")
  frecuenciaDias       Int?
  fuenteRecomendada    String?

  etapa EtapaFenologica @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  @@map("requerimientos_nutricionales")
}

model PlanRiego {
  id                String  @id @default(cuid())
  etapaId           String
  litrosPlantaDia   Float?
  frecuenciaDias    Int?
  metodoRecomendado String?

  etapa EtapaFenologica @relation(fields: [etapaId], references: [id], onDelete: Cascade)

  @@map("planes_riego")
}

model PlagaEnfermedad {
  id                 String              @id @default(cuid())
  fichaId            String
  nombre             String
  tipo               TipoPlagaEnfermedad
  sintomas           String?
  imagenesRef        String[] // catálogo visual base para diagnóstico IA (RF15)
  umbralAlerta       Json? // condiciones climáticas que disparan riesgo (RF17)
  manejoRecomendado  String?
  etapasSusceptibles Int[] // ordenes de EtapaFenologica afectadas

  ficha FichaTecnica @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  @@map("plagas_enfermedades")
}

enum TipoPlagaEnfermedad {
  PLAGA
  ENFERMEDAD
  DEFICIENCIA_NUTRICIONAL
}

model CostoReferencia {
  id             String         @id @default(cuid())
  fichaId        String
  categoria      CategoriaGasto // reutiliza el enum existente de Gasto
  etapaOrden     Int?
  montoPorHa     Float?
  montoPorPlanta Float?
  frecuencia     String?
  descripcion    String?

  ficha FichaTecnica @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  @@map("costos_referencia")
}

model PuntoCurvaProduccion {
  id                  String @id @default(cuid())
  fichaId             String
  anioProduccion      Int
  kgPorPlantaEsperado Float?
  kgPorHaEsperado     Float?

  ficha FichaTecnica @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  @@unique([fichaId, anioProduccion])
  @@map("curva_produccion")
}

// ─── CROPS / CULTIVOS ─────────────────────────────────────────────────────────

model Cultivo {
  id                String          @id @default(cuid())
  loteId            String
  lote              Lote            @relation(fields: [loteId], references: [id], onDelete: Cascade)
  especie           String          @default("Aguacate")
  variedad          String          @default("Hass")
  especieId         String?
  especieCultivo    EspecieCultivo? @relation(fields: [especieId], references: [id])
  // Motor de fichas técnicas (Fase 1) — pinneado a una versión concreta al
  // crear el cultivo; ver CLAUDE.md §2.2 y docs/REQUERIMIENTOS.md ADR-002.
  // Nombrado "variedadCatalogo" (no "variedad") porque ese nombre ya lo usa
  // el campo legacy de texto libre `variedad` de arriba.
  variedadId        String?
  variedadCatalogo  Variedad?       @relation(fields: [variedadId], references: [id])
  fichaTecnicaId    String?
  fichaTecnica      FichaTecnica?   @relation(fields: [fichaTecnicaId], references: [id])
  fechaSiembra      DateTime?
  cantidadPlantas   Int?
  densidadHa        Int?
  etapa             EtapaCultivo    @default(PREPARACION)
  estado            EstadoCultivo   @default(ACTIVO)
  notas             String?
  portainjerto      String?
  proveedorMaterial String?
  sistemaSiembra    String?
  distanciaSiembra  String?
  observaciones     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  registros     RegistroCultivo[]
  gastos        Gasto[]
  ingresos      Ingreso[]
  jornales      Jornal[]
  inversiones   InversionCultivo[]
  alertas       AlertaClimatica[]
  enlaces       EnlaceCompartido[]
  polizas       PolizaCultivo[]
  siniestros    Siniestro[]
  analisisSuelo AnalisisSuelo[]

  @@map("cultivos")
}

enum EtapaCultivo {
  PREPARACION
  SIEMBRA
  ESTABLECIMIENTO
  CRECIMIENTO
  PRODUCCION
  COSECHA
}

enum EstadoCultivo {
  ACTIVO
  PAUSADO
  FINALIZADO
}

// ─── CROP LOGS / REGISTROS ────────────────────────────────────────────────────

model RegistroCultivo {
  id          String       @id @default(cuid())
  cultivoId   String
  cultivo     Cultivo      @relation(fields: [cultivoId], references: [id], onDelete: Cascade)
  tipo        TipoRegistro
  descripcion String
  fecha       DateTime     @default(now())
  imagenes    String[]
  datos       Json?
  // Bidirectional sync: optional 1:1 link to financial records
  gastoId     String?      @unique
  gasto       Gasto?       @relation(fields: [gastoId], references: [id])
  ingresoId   String?      @unique
  ingreso     Ingreso?     @relation(fields: [ingresoId], references: [id])
  createdAt   DateTime     @default(now())

  @@map("registros_cultivo")
}

enum TipoRegistro {
  SIEMBRA
  RIEGO
  FERTILIZACION
  PODA
  TRATAMIENTO_PLAGAS
  COSECHA
  OBSERVACION
  INSPECCION
  ALERTA
}

// ─── EXPENSES / GASTOS ────────────────────────────────────────────────────────

model Gasto {
  id             String         @id @default(cuid())
  userId         String
  fincaId        String
  loteId         String?
  cultivoId      String?
  concepto       String
  categoria      CategoriaGasto
  subcategoria   String?
  monto          Float
  cantidad       Float?
  unidad         String?
  precioUnitario Float?
  proveedor      String?
  numeroFactura  String?
  tipoGasto      TipoGasto      @default(VARIABLE)
  fecha          DateTime       @default(now())
  notas          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  finca   Finca    @relation(fields: [fincaId], references: [id])
  lote    Lote?    @relation(fields: [loteId], references: [id])
  cultivo Cultivo? @relation(fields: [cultivoId], references: [id])

  // Back-relation: optional link from registro de cultivo
  registro RegistroCultivo?

  @@map("gastos")
}

enum TipoGasto {
  FIJO
  VARIABLE
  INVERSION
}

// ─── BUDGET / PRESUPUESTO ─────────────────────────────────────────────────────

model Presupuesto {
  id            String         @id @default(cuid())
  userId        String
  fincaId       String
  anio          Int
  categoria     CategoriaGasto
  montoPlaneado Float
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  finca Finca @relation(fields: [fincaId], references: [id])

  @@unique([fincaId, anio, categoria])
  @@map("presupuestos")
}

// ─── LABOR / JORNALES ─────────────────────────────────────────────────────────
// Registro de mano de obra — mayor costo operativo en el campo colombiano.
// Se relaciona con finanzas como gasto automático categoría MANO_OBRA.

model Jornal {
  id              String   @id @default(cuid())
  cultivoId       String?
  cultivo         Cultivo? @relation(fields: [cultivoId], references: [id])
  loteId          String?
  lote            Lote?    @relation(fields: [loteId], references: [id])
  fecha           DateTime @default(now())
  operario        String // Nombre del trabajador
  horasTrabajadas Float    @default(8) // Horas del jornal (default: día completo)
  valorDia        Float // Tarifa día completa en COP (ej: $50.000)
  actividad       String // "Fumigada", "Abonada", "Limpia", "Riego manual"
  descripcion     String? // Detalles adicionales
  imagen          String?  @db.Text // Base64 data URL or external URL
  loteArea        String? // Si aplica a un área específica del lote
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("jornales")
}

enum CategoriaGasto {
  INSUMOS
  MANO_OBRA
  MAQUINARIA
  AGUA_RIEGO
  TRANSPORTE
  CERTIFICACIONES
  TIERRA
  SEMILLAS_PLANTULAS
  HERRAMIENTAS
  ENERGIA
  OTROS
}

// ─── INCOME / INGRESOS ────────────────────────────────────────────────────────

model Ingreso {
  id          String     @id @default(cuid())
  cultivoId   String?
  cultivo     Cultivo?   @relation(fields: [cultivoId], references: [id])
  compradorId String?
  comprador   Comprador? @relation(fields: [compradorId], references: [id])
  concepto    String
  monto       Float
  cantidadKg  Float?
  precioKg    Float?
  fecha       DateTime   @default(now())
  notas       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Back-relation: optional link from registro de cultivo
  registro RegistroCultivo?

  @@map("ingresos")
}

// ─── BUYERS / COMPRADORES ─────────────────────────────────────────────────────

model Comprador {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable durante la migración (mismo patrón que Finca.organizacionId en
  // Fase 0) — se backfillea con prisma/backfill-compradores-finca.ts a la
  // finca del userId creador. Habilita RBAC real (ADMIN_FINCA/COLABORADOR)
  // sobre "comprador", ya contemplado en la matriz de authz.ts pero bloqueado
  // hasta ahora porque el modelo solo tenía userId (deuda técnica, Fase 2).
  fincaId         String?
  finca           Finca?        @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  nombre          String
  tipo            TipoComprador
  ciudad          String
  departamento    String?
  contacto        String?
  email           String?
  telefono        String?
  capacidadTon    Float?
  precioKg        Float?
  notas           String?
  estado          String        @default("ACTIVO")
  // Cultivos que compra (valores libres, mismo patrón que Cultivo.especie —
  // "Aguacate"/"Café"/"Cacao"... — no un enum, para no bloquear cultivos
  // nuevos antes de que exista el motor de fichas técnicas completo, ver
  // CLAUDE.md §2.2 y §4). Vacío = comprador sin especie declarada aún
  // (compradores existentes antes de esta migración).
  especiesInteres String[]      @default([])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  ingresos Ingreso[]
  enlaces  EnlaceCompartido[]

  @@map("compradores")
}

enum TipoComprador {
  COOPERATIVA
  EXPORTADOR
  MAYORISTA
  SUPERMERCADO
  PLAZA_MERCADO
  RESTAURANTE
  OTRO
}

// ─── INVESTORS / INVERSIONISTAS ────────────────────────────────────────────
// Fase 3 (parcial) — ver CLAUDE.md §2.5 y docs/REQUERIMIENTOS.md ADR-003.
// Mismo patrón que Comprador: un contacto gestionado por el productor
// (userId = dueño de la finca que lo registra), NO un User con login propio
// — el rol INVERSIONISTA con sesión y acceso scoped queda para cuando el
// RBAC real (Fase 2) esté enforced en las rutas. Se puede agregar más
// adelante un `cuentaUserId String?` opcional, igual que está previsto para
// Comprador.userId en el gap analysis, sin romper este modelo.

model Inversionista {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("InversionistaDueno", fields: [userId], references: [id], onDelete: Cascade)
  nombre       String
  email        String?
  telefono     String?
  notas        String?
  // ADR-011 (Fase 3): el `cuentaUserId` previsto arriba. Cuando el inversionista
  // tiene login propio (rol INVESTOR), apunta a SU User — `userId` sigue siendo
  // el dueño que lo registró. El scope de cultivos financiados NO se duplica en
  // `Membresia` (el ADR proponía `cultivosScope String[]`): se deriva de
  // `InversionCultivo`, que ya es la fuente de verdad y evita que diverjan.
  cuentaUserId String?
  cuenta       User?    @relation("InversionistaUsuario", fields: [cuentaUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inversiones InversionCultivo[]

  @@index([cuentaUserId])
  @@map("inversionistas")
}

// Aporte de un inversionista a un cultivo ESPECÍFICO (no a la finca completa)
// — requisito de negocio explícito: un inversionista puede financiar el lote
// de cacao sin tener visibilidad ni participación en el de café.
model InversionCultivo {
  id                      String          @id @default(cuid())
  cultivoId               String
  cultivo                 Cultivo         @relation(fields: [cultivoId], references: [id], onDelete: Cascade)
  inversionistaId         String
  inversionista           Inversionista   @relation(fields: [inversionistaId], references: [id], onDelete: Cascade)
  montoAportado           Float
  fechaAporte             DateTime        @default(now())
  moneda                  String          @default("COP")
  porcentajeParticipacion Float
  condiciones             String?
  estado                  EstadoInversion @default(ACTIVA)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  retornos RetornoInversion[]

  @@map("inversiones_cultivo")
}

enum EstadoInversion {
  ACTIVA
  RETIRADA
  FINALIZADA
}

// Historial de retornos entregados al inversionista — separado de Ingreso
// (que es la venta del cultivo) porque un retorno es la distribución de
// utilidad, no necesariamente 1:1 con una venta puntual.
model RetornoInversion {
  id          String           @id @default(cuid())
  inversionId String
  inversion   InversionCultivo @relation(fields: [inversionId], references: [id], onDelete: Cascade)
  monto       Float
  fecha       DateTime         @default(now())
  concepto    String?
  createdAt   DateTime         @default(now())

  @@map("retornos_inversion")
}

// ─── WEATHER ALERTS / ALERTAS CLIMÁTICAS ─────────────────────────────────────

model AlertaClimatica {
  id          String     @id @default(cuid())
  tipo        TipoAlerta
  titulo      String
  descripcion String
  severidad   Severidad  @default(MEDIA)
  fechaInicio DateTime
  fechaFin    DateTime?
  activa      Boolean    @default(true)
  leida       Boolean    @default(false)
  datos       Json?
  municipio   String?
  createdAt   DateTime   @default(now())

  // Aislamiento por finca/cultivo — antes este modelo no tenía dueño y
  // GET /api/alertas devolvía TODO a cualquier usuario autenticado. Ambos
  // opcionales: las alertas climáticas (HELADA, LLUVIA_EXCESIVA, etc.) son
  // a nivel finca; las de PLAGA (motor de fichas técnicas, Fase 5) son
  // específicas de un cultivo. Ver prisma/backfill-alertas-finca.ts.
  fincaId   String?
  finca     Finca?   @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  cultivoId String?
  cultivo   Cultivo? @relation(fields: [cultivoId], references: [id], onDelete: Cascade)

  @@map("alertas_climaticas")
}

enum TipoAlerta {
  HELADA
  LLUVIA_EXCESIVA
  SEQUIA
  VIENTO_FUERTE
  TEMPERATURA_ALTA
  GRANIZO
  PLAGA
  // Recordatorio proactivo de manejo (riego/fertilización/poda/inspección)
  // proyectado desde ActividadCalendario de la ficha técnica del cultivo —
  // no reacciona a clima, reacciona al calendario agronómico. Ver RF17/RF18
  // en docs/REQUERIMIENTOS.md ("brecha funcional real, no solo de datos").
  ACTIVIDAD
  OTRO
}

enum Severidad {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

// ─── AI CHAT / HISTORIAL IA ───────────────────────────────────────────────────

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String   @db.Text
  tokens    Int?
  createdAt DateTime @default(now())

  @@map("chat_messages")
}

enum ChatRole {
  USER
  ASSISTANT
}

// Log de auditoría — acciones sensibles (eliminar/exportar cuenta, cambios de
// equipo, bloqueos de login). Deliberadamente SIN relación/FK a User: un
// registro de auditoría debe sobrevivir a que el actor sea borrado (el caso
// más importante es justo "cuenta.eliminar" — si tuviera onDelete: Cascade,
// el log desaparecería justo en el momento que más importa). Se guarda un
// snapshot del email en vez de solo el id, por la misma razón.
//
// ADR-011 (ISO 27001 A.8.15) — campos aditivos, todos opcionales para que los
// 29 call sites actuales de registrarAuditoria() (src/lib/audit.ts) sigan
// funcionando sin cambios. Equivalencias con el `AuditLog` del ADR:
// userId→actorId · metadata→detalle · ipAddress/userAgent (nuevos).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  accion     String
  detalle    Json?
  createdAt  DateTime @default(now())

  organizacionId  String?
  // Ej.: "Finca", "Membresia", "Organizacion" (+ recursoId).
  recurso         String?
  recursoId       String?
  resultado       ResultadoAudit @default(EXITO)
  ipAddress       String?
  userAgent       String?
  // Encadenamiento SHA-256 (inmutabilidad). Nulos en los registros previos al
  // Sprint 5. Ojo al implementarlo: con escrituras concurrentes (serverless)
  // una cadena GLOBAL se rompe → una cadena por organizacionId + transacción
  // serializable.
  hashPrevio      String?
  hashActual      String?
  // Impersonación de soporte (ADR-011 §6.5): cada acción hecha "como" otro
  // usuario queda con quién la ejecutó realmente y a quién representaba. El
  // ADR lo exige pero su schema no traía estas columnas.
  soporteUserId   String?
  targetUserId    String?
  esImpersonacion Boolean        @default(false)

  // Se conserva el índice original [actorId] (reemplazarlo por el compuesto
  // [actorId, createdAt] del ADR generaría un DROP INDEX; lo evaluamos en el
  // Sprint 5, cuando haya volumen real que justifique el cambio).
  @@index([actorId])
  @@index([accion])
  @@index([createdAt])
  @@index([organizacionId, createdAt])
  @@index([recurso, recursoId])
  @@map("audit_log")
}

enum ResultadoAudit {
  EXITO
  FALLIDO
  DENEGADO
}

// Cuota diaria de uso de IA (chat/voz/imagen) — todas pegan a Groq, que cobra
// por uso. Antes /api/chat no verificaba sesión y ningún endpoint de IA tenía
// límite de volumen (solo transcribir/diagnostico exigían sesión) — esto es
// la segunda capa: ya autenticado, un límite razonable evita que una cuenta
// comprometida o un bug de UI (loop de requests) genere una factura enorme.
// Un contador por día@tipo en Postgres (no Redis: no hay Redis en producción,
// ver CLAUDE.md §3) — barato de mantener, correcto entre instancias
// serverless (a diferencia de un contador en memoria).
model UsoIaDiario {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo     TipoUsoIa
  fecha    DateTime  @db.Date
  contador Int       @default(0)

  @@unique([userId, tipo, fecha])
  @@map("uso_ia_diario")
}

enum TipoUsoIa {
  CHAT
  VOZ
  IMAGEN
}

// ─── USER PREFERENCES ─────────────────────────────────────────────────────────

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tempMinAlert Float @default(12)
  tempMaxAlert Float @default(32)
  rainAlertMm  Float @default(30)
  windAlertKmh Float @default(40)
  droughtDays  Int   @default(5)

  lat       Float  @default(7.9273)
  lng       Float  @default(-72.5078)
  municipio String @default("Norte de Santander")

  emailAlerts Boolean @default(true)
  pushAlerts  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

// ─── PORTAL DE COMPRADORES (Fase 4) ────────────────────────────────────────────
// Enlace de solo lectura, sin necesidad de cuenta, para que un comprador
// externo vea el estado de un cultivo (etapa, proyección de cosecha, fotos
// recientes) sin exponer datos financieros/de costos de la finca — ver
// CLAUDE.md §2 y docs/REQUERIMIENTOS.md §9 (Fase 4, ADR pendiente de
// formalizar). `token` es el identificador público (alta entropía,
// generado con crypto.randomBytes — no usar `id` en la URL pública).

model EnlaceCompartido {
  id          String     @id @default(cuid())
  token       String     @unique
  cultivoId   String
  cultivo     Cultivo    @relation(fields: [cultivoId], references: [id], onDelete: Cascade)
  compradorId String?
  comprador   Comprador? @relation(fields: [compradorId], references: [id], onDelete: SetNull)
  creadoPorId String
  creadoPor   User       @relation(fields: [creadoPorId], references: [id])

  nota     String? // mensaje opcional del productor, visible en el portal público
  expiraEn DateTime?
  revocado Boolean   @default(false)

  vistas        Int       @default(0)
  ultimaVistaEn DateTime?

  createdAt DateTime @default(now())

  @@map("enlaces_compartidos")
}

// ─── EXPERIENCIA CAMPESINO (ADR-006, fase posterior) ───────────────────────────
// Tercera experiencia, solo móvil, perfil de baja alfabetización digital.
// Vive en su propio árbol de rutas (src/app/(campesino)/campesino/*), no en
// /dashboard/*. Por decisión explícita de producto, el Campesino usa estas
// funciones SIN que se le cree Finca/Lote/Cultivo — ver ConsultaDiagnostico-
// Campesino más abajo (reemplaza a RegistroCultivo solo para este flujo).

enum CommodityMercado {
  CAFE
  CACAO
  AGUACATE
  CITRICOS
}

enum TendenciaPrecio {
  SUBIO
  BAJO
  IGUAL
}

// Precio de mercado (comercialización) — deliberadamente NO es una FK a
// EspecieCultivo: esa jerarquía modela agronomía de producción versionada,
// un dominio distinto con un ciclo de vida propio. Cargado a mano por un
// Super Admin (ver src/app/(dashboard)/dashboard/admin/precios-mercado/).
model PrecioMercado {
  id        String           @id @default(cuid())
  commodity CommodityMercado
  precioKg  Float
  unidad    String           @default("kg")
  fecha     DateTime         @default(now())
  // Calculada y CONGELADA en el momento de creación (comparando contra el
  // registro anterior más reciente del mismo commodity) — no se recalcula en
  // cada lectura, así el historial no cambia retroactivamente si se edita o
  // borra un registro viejo.
  tendencia TendenciaPrecio
  activo    Boolean          @default(true)

  creadoPorId String
  creadoPor   User     @relation(fields: [creadoPorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([commodity, fecha])
  @@map("precios_mercado")
}

// Calcada de la clasificación real del portal web (CrecIAgro) — hallazgo
// del usuario, 2026-08-29: "la clasificación debe ser igual a la que
// tenemos en el portal web". Reemplaza la anterior (Fertilizantes/Semillas/
// Protección/Equipos/Herramientas/Maquinaria), que era una lista genérica
// inventada antes de tener la real.
enum CategoriaProducto {
  FERTILIZANTES
  SEMILLAS
  BIOINSUMOS
  AGROQUIMICOS
  NUTRICION_VEGETAL
  RIEGO_MAQUINARIA
}

// Catálogo informativo de insumos — sin carrito ni pedidos (decisión
// explícita de producto). Tocar un producto en la UI redirige a urlExterna
// (portal CrecIAgro, hoy sin API — placeholder mientras no esté en línea).
model ProductoTienda {
  id           String            @id @default(cuid())
  categoria    CategoriaProducto
  nombre       String
  descripcion  String?
  precio       Float?
  unidadPrecio String?
  imagenUrl    String?
  urlExterna   String
  destacado    Boolean           @default(false)
  activo       Boolean           @default(true)
  orden        Int               @default(0)

  creadoPorId String
  creadoPor   User     @relation(fields: [creadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoria, activo])
  @@map("productos_tienda")
}

// Historial de diagnósticos del flujo Campesino — reemplaza a RegistroCultivo
// para este flujo porque, por decisión de producto, el Campesino no tiene
// Finca/Lote/Cultivo. Alimenta "Mis consultas" en /campesino/perfil.
model ConsultaDiagnosticoCampesino {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  especieSlug   String // "cafe-caturra" | "cacao-ccu51" | "aguacate-hass" | "citricos-generico"
  especieNombre String // label mostrado: "Café" | "Cacao" | "Aguacate" | "Cítricos"
  imagenValida  Boolean
  diagnostico   String
  confianza     String? // "alta" | "media" | "baja"
  recomendacion String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@map("consultas_diagnostico_campesino")
}

// ═══════════════════════════════════════════════════════════════════════════════
// IAM — ADR-011 "Modelo de Identidad, Roles y Permisos"
// ═══════════════════════════════════════════════════════════════════════════════
// Estado del ADR: PROPUESTO (docs/ADR-011-Modelo-Identidad-Roles-Permisos.md).
// Este bloque es la fusión de `schema-iam.prisma` (original archivado en
// docs/anexos/) con el schema previo: los modelos que ya existían (User,
// Organizacion, Membresia, AuditLog, Inversionista) se EXTENDIERON arriba,
// en su lugar, con campos aditivos; aquí viven las piezas que no existían.
// Mapeo completo y decisiones: docs/ADR-011-notas-de-implementacion.md.
//
// Capas 4-5 (Rol → Permiso): los permisos NO viven en la base de datos sino en
// código TypeScript (src/lib/authz/permissions.ts y policies.ts) — decisión del
// ADR por type-safety y menor superficie de ataque.
// ═══════════════════════════════════════════════════════════════════════════════

// Los 9 roles del ADR (§2.2). `Membresia.rol` (RolOrganizacion) sigue mandando
// hasta el cutover; `Membresia.rolesIam` guarda el/los equivalente(s) en este enum.
enum Rol {
  // Plataforma (CrecIAgro S.A.S.) — Membresía en la org CRECIAGRO_INTERNAL
  SUPER_ADMIN // máx. 5 personas
  PLATFORM_SUPPORT
  // Organización
  ORG_OWNER
  ORG_ADMIN
  // Finca (con scope: Membresia.fincaId)
  FARM_OWNER
  FARM_ADMIN
  FARM_COLLABORATOR
  // Funcionales
  INVESTOR // cultivos financiados (Fase 3)
  BUYER // enlaces compartidos (Fase 4)
}

enum EstadoMembresia {
  ACTIVA
  PENDIENTE_INVITACION
  SUSPENDIDA
  REVOCADA
}

// Sin BUYER_TOKEN (el ADR lo listaba): un comprador NO tiene User — entra por
// EnlaceCompartido (/portal/[token]), que ya resuelve ese caso. Con GOOGLE (el
// ADR no lo contemplaba): el login "Otro rol" con Google ya existe.
enum MetodoAuth {
  EMAIL_PASSWORD
  GOOGLE
  WHATSAPP_MAGIC_LINK // Campesino — único canal, sin fallback SMS (decisión del fundador, sujeta a firma)
  SAML_SSO
}

enum TipoOrg {
  INDIVIDUAL
  COOPERATIVA
  GREMIO
  ASOCIACION_CAMPESINA
  FUNDACION
  GOBIERNO
  UNIVERSIDAD
  ONG
  EMPRESA_PRIVADA
  CRECIAGRO_INTERNAL // tenant único de CrecIAgro S.A.S.
}

enum EstadoPlan {
  EN_TRIAL
  ACTIVA
  SUSPENDIDA_PAGO
  CANCELADA
  MOROSA
}

enum CicloFacturacion {
  MENSUAL
  ANUAL // 20 % de descuento
}

// Sesión revocable. OJO (hallazgo de la revisión del ADR): NextAuth v4 con el
// provider Credentials SIEMPRE emite JWT — no admite la estrategia "database"
// (ver next-auth/core/routes/callback.js: UnsupportedStrategy). Por eso esta
// tabla NO sustituye al JWT: funciona como LISTA DE REVOCACIÓN. El JWT lleva un
// `sesionId`; `tokenHash` es su SHA-256; en cada request se valida que la fila
// exista, no esté revocada ni vencida. Se implementa en el Sprint 1.
model Sesion {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  dispositivo String?
  userAgent   String?
  ipAddress   String?
  ubicacion   String? // geolocalización por IP (opcional)
  expiraEn    DateTime
  revocadaEn  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, revocadaEn])
  @@index([expiraEn])
  @@map("sesiones")
}

enum TipoToken {
  MAGIC_LINK_WHATSAPP
  RESET_PASSWORD
  VERIFY_EMAIL
  MFA_BACKUP_CODE
}

// Tokens de un solo uso, guardados como HASH (SHA-256) — el token en claro solo
// viaja por el canal (correo/WhatsApp). Hoy `User.tokenVerificacion` y
// `User.tokenResetPassword` (Tanda 2) están en texto plano; el Sprint 1 los
// migra aquí. `tokenHash` es @unique (el ADR traía solo @@index) porque la
// consulta natural es por hash. Sin BUYER_SHARE_LINK: ver MetodoAuth.
model TokenAuth {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo         TipoToken
  tokenHash    String    @unique
  metadata     Json? // ej. canal WhatsApp usado, IP de la solicitud
  expiraEn     DateTime
  usadoEn      DateTime?
  invalidadoEn DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, tipo])
  @@index([expiraEn])
  @@map("tokens_auth")
}

// Login Campesino seguro — código de un solo uso que el DUEÑO genera para que
// un campesino vincule su celular. Modelo propio (no TokenAuth): el código es
// de 6 dígitos, así que un `tokenHash @unique` global colisionaría entre
// usuarios. Se guarda como HMAC(secreto del servidor, userId:codigo); la
// defensa real contra fuerza bruta es el tope de intentosFallidos (5) y el
// rate limit por IP+teléfono, no el hash.
model CodigoVinculacion {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codigoHash       String
  creadoPorId      String? // dueño que lo generó (auditoría)
  expiraEn         DateTime
  usadoEn          DateTime?
  invalidadoEn     DateTime?
  intentosFallidos Int       @default(0)
  createdAt        DateTime  @default(now())

  @@index([userId, usadoEn])
  @@map("codigos_vinculacion")
}

// Celular de un campesino ya vinculado. La cookie `germia_dispositivo`
// (httpOnly) lleva el token en claro; acá solo su SHA-256. Se mantiene
// aparte de `Sesion` a propósito: Sesion es una lista de revocación de JWT
// (30 días), esto es una confianza de larga duración que evita volver a
// pedir el código cada vez que vence la sesión.
model DispositivoConfianza {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  userAgent   String?
  ipAddress   String?
  ultimoUsoEn DateTime  @default(now())
  expiraEn    DateTime
  revocadoEn  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, revocadoEn])
  @@map("dispositivos_confianza")
}

enum CanalInvitacion {
  EMAIL
  WHATSAPP
}

// Invitación pendiente (por correo o WhatsApp). El "propietarioTemp" que
// menciona ADR-011 §6.2 no hace falta: se crea la Finca y la invitación la
// referencia con `fincaId`. `invitadaPor` con Cascade (el ADR no lo definía):
// sin él, borrar a un usuario que alguna vez invitó a alguien —incluido el
// derecho al olvido de la Ley 1581— quedaría bloqueado por la FK.
model Invitacion {
  id              String          @id @default(cuid())
  organizacionId  String
  organizacion    Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  emailOCelular   String // correo, o celular en E.164
  canalEnvio      CanalInvitacion
  rol             Rol
  fincaId         String?
  finca           Finca?          @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  tokenHash       String          @unique
  expiraEn        DateTime
  aceptadaEn      DateTime?
  invitadaPorId   String
  invitadaPor     User            @relation("InvitacionesEnviadas", fields: [invitadaPorId], references: [id], onDelete: Cascade)
  mensajePersonal String?
  createdAt       DateTime        @default(now())

  @@index([organizacionId, aceptadaEn])
  @@index([emailOCelular])
  @@index([expiraEn])
  @@map("invitaciones")
}

enum EstadoPago {
  PENDIENTE
  PAGADA
  VENCIDA
  ANULADA
}

// Referencial (ADR-011): el modelo de facturación completo es ADR-012 (en
// curso). Monto en Decimal — el resto del schema usa Float para dinero, pero
// aquí es una tabla nueva y Decimal es lo correcto para cifras de cobro.
model Facturacion {
  id             String       @id @default(cuid())
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  periodo        String // YYYY-MM
  montoCop       Decimal      @db.Decimal(12, 2)
  estado         EstadoPago   @default(PENDIENTE)
  pagadaEn       DateTime?
  createdAt      DateTime     @default(now())

  @@unique([organizacionId, periodo])
  @@map("facturacion")
}

enum EstadoImpersonacion {
  PENDIENTE_CONSENTIMIENTO
  ACTIVA
  FINALIZADA
  DENEGADA
  EXPIRADA
}

// PLATFORM_SUPPORT actúa como otro usuario SOLO con consentimiento explícito
// del usuario objetivo y por máx. 2 h. ⚠️ Una de las 3 decisiones del ADR que
// requieren firma de los cofundadores antes de implementarse (Sprint 7): esta
// tabla queda creada pero SIN uso. Las FK a User son Cascade (no Restrict) para
// no bloquear la baja de una cuenta por derecho al olvido; el rastro de lo que
// se hizo vive en AuditLog (sin FK, sobrevive).
model Impersonacion {
  id                   String              @id @default(cuid())
  soporteUserId        String
  soporte              User                @relation("ImpersonacionSoporte", fields: [soporteUserId], references: [id], onDelete: Cascade)
  targetUserId         String
  target               User                @relation("ImpersonacionTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  organizacionId       String?
  // Hash del token enviado al usuario objetivo
  tokenConsentimiento  String              @unique
  consentimientoDadoEn DateTime?
  canalConsentimiento  CanalInvitacion?
  motivo               String
  iniciadaEn           DateTime?
  finalizadaEn         DateTime?
  expiraEn             DateTime // 2 h por defecto
  estado               EstadoImpersonacion @default(PENDIENTE_CONSENTIMIENTO)
  createdAt            DateTime            @default(now())

  @@index([targetUserId, estado])
  @@index([soporteUserId, estado])
  @@map("impersonaciones")
}

// ─── SEGUROS AGRÍCOLAS / SINIESTROS ──────────────────────────────────────────
// El productor REGISTRA la póliza que contrató con una aseguradora (GermIA no
// vende ni intermedia seguros) y la asocia a uno o varios cultivos; cuando
// ocurre un evento registra el siniestro sobre el cultivo y arma el expediente.
// `creadoPorId`/`gastoId` son texto plano SIN clave foránea a propósito: no deben
// bloquear la eliminación de una cuenta ni de un gasto.

enum RiesgoAsegurado {
  SEQUIA
  EXCESO_LLUVIA
  HELADA
  GRANIZO
  VIENTOS_FUERTES
  INUNDACION
  PLAGAS_ENFERMEDADES
  INCENDIO
  OTRO
}

enum EstadoPoliza {
  ACTIVA
  CANCELADA
}

enum EstadoSiniestro {
  REGISTRADO
  REPORTADO_ASEGURADORA
  EN_REVISION
  APROBADO
  PAGADO
  RECHAZADO
}

model PolizaSeguro {
  id            String            @id @default(cuid())
  fincaId       String
  finca         Finca             @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  aseguradora   String
  numeroPoliza  String?
  riesgos       RiesgoAsegurado[]
  sumaAsegurada Float?
  prima         Float?
  deduciblePct  Float?
  fechaInicio   DateTime
  fechaFin      DateTime
  estado        EstadoPoliza      @default(ACTIVA)
  contacto      String?
  notas         String?
  gastoId       String?
  creadoPorId   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  cultivos   PolizaCultivo[]
  siniestros Siniestro[]

  @@index([fincaId])
  @@map("polizas_seguro")
}

model PolizaCultivo {
  polizaId  String
  poliza    PolizaSeguro @relation(fields: [polizaId], references: [id], onDelete: Cascade)
  cultivoId String
  cultivo   Cultivo      @relation(fields: [cultivoId], references: [id], onDelete: Cascade)

  @@id([polizaId, cultivoId])
  @@index([cultivoId])
  @@map("polizas_cultivo")
}

model Siniestro {
  id                      String          @id @default(cuid())
  fincaId                 String
  finca                   Finca           @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  // Cascade en la BD (un Restrict rompería el borrado en cascada de una finca
  // entera, según el orden de las cascadas). La protección real es la guarda de
  // borrado de cultivo/lote (src/lib/borrado-guardas.ts): un cultivo con
  // siniestros NO se puede borrar, es evidencia de un reclamo.
  cultivoId               String
  cultivo                 Cultivo         @relation(fields: [cultivoId], references: [id], onDelete: Cascade)
  polizaId                String?
  poliza                  PolizaSeguro?   @relation(fields: [polizaId], references: [id], onDelete: SetNull)
  tipo                    RiesgoAsegurado
  fechaEvento             DateTime
  descripcion             String
  areaAfectadaHa          Float?
  porcentajeDanio         Int?
  perdidaEstimada         Float?
  estado                  EstadoSiniestro @default(REGISTRADO)
  numeroReclamo           String?
  fechaReporteAseguradora DateTime?
  montoIndemnizado        Float?
  imagenes                String[]
  notas                   String?
  creadoPorId             String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([fincaId])
  @@index([cultivoId])
  @@map("siniestros")
}
